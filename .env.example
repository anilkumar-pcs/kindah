# ---------------------------------------------------------------------------
# Kindly local development environment
# Copy to .env. These are local-only placeholders, never production secrets.
# ---------------------------------------------------------------------------

# Application
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (source of truth)
# Create once with: createdb kindah_dev && createdb kindah_test
DATABASE_URL=postgresql+psycopg://localhost:5432/kindah_dev
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/kindah_test
DB_CONNECT_TIMEOUT_SECONDS=3

# Redis (optional cache/rate-limit only; never correctness)
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1.0

# Local authentication/crypto placeholders. Replace outside local development.
JWT_SECRET=dev-only-jwt-secret-change-me-minimum-32-characters
REFRESH_TOKEN_PEPPER=dev-only-refresh-token-pepper-change-me-minimum-32-characters
CRYPTO_KEY=dev-only-crypto-key-change-me-minimum-32-characters
LOOKUP_HMAC_KEY=dev-only-lookup-hmac-change-me-minimum-32-characters
OTP_HMAC_KEY=dev-only-otp-hmac-change-me-minimum-32-characters

# Authentication/session timing
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_PHONE_LIMIT=3
OTP_IP_LIMIT=20
OTP_WINDOW_MINUTES=15
# Used only by the test SMS adapter; production rejects the test adapter.
OTP_TEST_CODE=123456
LEGAL_POLICY_VERSION=draft-2026-11-23

# Payment-method and wish rules
REAUTH_WINDOW_MINUTES=10
WISH_LIFETIME_HOURS=24
WISH_COOLDOWN_HOURS=72
WISH_MESSAGE_MIN=10
WISH_MESSAGE_MAX=120
MIN_GIFT_INR=10
MAX_GIFT_INR=100
# Comma-separated moderation terms; empty by default until legal/product input.
PROHIBITED_WISH_TERMS=
RESERVATION_MINUTES=10
RESERVATION_EXTENSION_MINUTES=20
RECIPIENT_RESPONSE_HOURS=24
UNRESOLVED_CLAIM_LIMIT=2
CHEER_MAX_CHARS=80
REPORT_RATE_LIMIT_PER_HOUR=10
AUTO_HIDE_REPORT_THRESHOLD=3
ADMIN_MFA_TTL_MINUTES=15
ADMIN_MFA_ISSUER=Kindly Admin
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_BATCH_SIZE=100
HANDOFF_PROVIDER=test
# Local/test admin allow-list (comma-separated user UUIDs). Phase 6 replaces with RBAC/MFA.
ADMIN_USER_IDS=

# Providers. Production rejects the local/test adapters.
SMS_PROVIDER=test
CRYPTO_PROVIDER=local

# Payment safety: real-money handoff must stay disabled in development.
PAYMENTS_LIVE_ENABLED=false
HANDOFF_MODE=test

# Frontend (also copy frontend/.env.example to frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
