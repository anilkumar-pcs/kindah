# ---------------------------------------------------------------------------
# Kindly local development environment
# Copy to .env. These are local-only placeholders, never production secrets.
# ---------------------------------------------------------------------------

# Application
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (source of truth)
# Create once with: createdb kindah_dev && createdb kindah_test
DATABASE_URL=postgresql+psycopg://localhost:5432/kindah_dev
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/kindah_test
DB_CONNECT_TIMEOUT_SECONDS=3

# Redis (optional cache/rate-limit only; never correctness)
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1.0

# Local authentication/crypto placeholders. Replace outside local development.
JWT_SECRET=dev-only-jwt-secret-change-me
REFRESH_TOKEN_PEPPER=dev-only-refresh-token-pepper-change-me
CRYPTO_KEY=dev-only-crypto-key-change-me

# Payment safety: real-money handoff must stay disabled in development.
PAYMENTS_LIVE_ENABLED=false
HANDOFF_MODE=test

# Frontend (also copy frontend/.env.example to frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
